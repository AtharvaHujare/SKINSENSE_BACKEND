# Environment Configuration Template for SkinSense AI Backend

# Application Settings
APP_NAME="SkinSense AI Backend"
APP_VERSION="0.1.0"
ENV="development"
DEBUG=True
HOST="0.0.0.0"
PORT=8000

# Security & Authentication Settings
SECRET_KEY="skinsense-super-secret-key-change-in-production-32bytes"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Configuration Parameters
DATABASE_HOST="localhost"
DATABASE_PORT=5432
DATABASE_NAME="skinsense_db"
DATABASE_USER="postgres"
DATABASE_PASSWORD="your_postgres_password"

# Database Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# Storage Directories Configuration
UPLOADS_DIR="uploads"
REPORTS_DIR="reports"
TRAINED_MODELS_DIR="trained_models"
