# Environment Configuration Template for SkinSense AI Backend

# Application Settings
APP_NAME="SkinSense AI Backend"
APP_VERSION="0.1.0"
ENV="development"
DEBUG=True
HOST="0.0.0.0"
PORT=8000

# Security Settings Placeholder (Do NOT commit secret keys)
SECRET_KEY="your-super-secret-key-placeholder"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database Configuration Placeholder
DATABASE_URL="postgresql+asyncpg://user:password@localhost:5432/skinsense"

# Storage Directories Configuration
UPLOADS_DIR="uploads"
REPORTS_DIR="reports"
TRAINED_MODELS_DIR="trained_models"
